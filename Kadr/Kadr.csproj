<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- libmpv-2.dll 64-битная, поэтому и программа только 64-битная. -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Kadr</AssemblyName>
    <RootNamespace>Kadr</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Значок программы; рисуется скриптом tools\make-icon.ps1. -->
    <ApplicationIcon>Kadr.ico</ApplicationIcon>
    <!-- Сведения о программе (видны в свойствах Kadr.exe). -->
    <Product>Kadr</Product>
    <AssemblyTitle>Kadr — видеоплеер</AssemblyTitle>
    <Version>1.0.0</Version>
    <!-- Итоговая сборка: dotnet publish Kadr -c Release -o publish\Kadr (CLAUDE.md, раздел 2.1).
         Нужна установленная среда .NET 10 Desktop Runtime; файлы отладки (.pdb) в неё не кладём. -->
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Движок воспроизведения: кладётся рядом с Kadr.exe. -->
    <None Include="..\lib\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Справка для пользователя входит в поставку. -->
    <None Update="Горячие клавиши.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Тот же значок — для окна видео (панель задач, Alt+Tab). -->
    <Resource Include="Kadr.ico" />
  </ItemGroup>

  <!-- Понятная ошибка вместо падения при запуске, если движок забыли положить в lib\. -->
  <Target Name="CheckLibmpv" BeforeTargets="Build" Condition="!Exists('..\lib\libmpv-2.dll')">
    <Error Text="Не найден lib\libmpv-2.dll. Возьмите его из архива mpv-dev-x86_64-…7z (см. CLAUDE.md, раздел 2) и положите в папку lib рядом с Kadr.slnx." />
  </Target>

</Project>
