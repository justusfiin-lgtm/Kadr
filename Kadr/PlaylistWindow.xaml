<local:FloatingWindow x:Class="Kadr.PlaylistWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:Kadr"
                      Title="Плейлист — Kadr" Width="440" Height="585" AllowDrop="True">
    <DockPanel Background="Transparent">
        <DockPanel.ContextMenu>
            <ContextMenu Opened="OnMenuOpened">
                <MenuItem Header="Добавить файлы…" Click="OnAddFilesClick" />
                <MenuItem Header="Добавить папку…" Click="OnAddFolderClick" />
                <Separator />
                <MenuItem x:Name="RemoveMenuItem" Header="Удалить выбранный" InputGestureText="Delete" Click="OnRemoveClick" />
                <MenuItem x:Name="ClearMenuItem" Header="Очистить" Click="OnClearClick" />
                <Separator />
                <MenuItem x:Name="SortMenuItem" Header="Сортировать по имени" Click="OnSortClick" />
            </ContextMenu>
        </DockPanel.ContextMenu>

        <!-- Заголовок: «Плейлист», путь к папке, кнопка закрытия (раздел 4.3). -->
        <Border DockPanel.Dock="Top" Height="56" Padding="16,0,12,0"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Плейлист" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="FolderText" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <local:IconButton Grid.Column="1" Width="32" Height="32"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  ToolTip="Закрыть плейлист (L)" Click="OnCloseClick">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M6,6 L18,18 M18,6 L6,18" Style="{StaticResource IconStroke}" />
                        </Canvas>
                    </Viewbox>
                </local:IconButton>
            </Grid>
        </Border>

        <!-- Подвал: «N файлов · по алфавиту». -->
        <Border DockPanel.Dock="Bottom" Height="48" Padding="16,0"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>

        <!-- Список файлов: номер (у текущего — треугольник ▶) и имя. Двойной щелчок — воспроизвести. -->
        <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectionMode="Single"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource PlaylistRow}"
                 MouseDoubleClick="OnRowDoubleClick" KeyDown="OnListKeyDown">
            <ListBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBar}" />
            </ListBox.Resources>
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="local:PlaylistItem">
                    <Grid Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Viewbox x:Name="Marker" Width="12" Height="12" HorizontalAlignment="Right" Visibility="Collapsed">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5,3 L21,12 L5,21 Z" Fill="{StaticResource AccentBrush}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Name}" ToolTip="{Binding Path}"
                                   FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</local:FloatingWindow>
