<Window x:Class="Kadr.FileInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о файле — Kadr"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" MinWidth="420" MaxWidth="640"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
    <!-- Окно в палитре плеера (раздел 4.1). Перетаскивается за любое место, Esc или Enter — закрыть. -->
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="Информация о файле" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Grid x:Name="Rows">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>
        <Button Style="{StaticResource TextButton}" Content="Закрыть" HorizontalAlignment="Right"
                Margin="0,16,0,0" Click="OnCloseClick" />
    </StackPanel>
</Window>
