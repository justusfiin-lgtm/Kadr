<Window x:Class="Kadr.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kadr"
        Title="Kadr" Width="720" Height="405" Icon="Kadr.ico"
        WindowStyle="None" ResizeMode="CanMinimize"
        Background="{StaticResource VideoBackgroundBrush}"
        BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1"
        WindowStartupLocation="Manual" AllowDrop="True">
    <!-- ResizeMode="CanMinimize": рамки и кнопок нет, но щелчок по кнопке на панели задач сворачивает окно. -->
    <Grid>
        <!-- Пустой плеер (нечего восстанавливать): подсказка вместо чёрного окна. -->
        <TextBlock x:Name="EmptyHint" Visibility="Collapsed" Margin="24"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="14" LineHeight="22"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Перетащите сюда видео или папку&#10;или щёлкните правой кнопкой → «Открыть файл…»" />
        <local:VideoHost x:Name="Video" />
    </Grid>
</Window>
